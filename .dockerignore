node_modules
dist
# Never ship host-built workspace artifacts: the image must build its own
# packages/*/dist, or a stale host dist silently becomes the runtime core (#138).
packages/*/dist
coverage
.git
.github
.planning
.auditing
.obsidian
.claude
.husky
tests
secrets
data
config/config.json
config/cmds.bash
.env
.env.*
*.log
logs
.DS_Store
.vitest
*.md
!package.json
# SKILL.md is served at /SKILL.md by src/routes/agent-discovery.ts and must
# exist in the production image; the *.md exclusion above would otherwise
# silently break `COPY SKILL.md` in the Dockerfile.
!SKILL.md
