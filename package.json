{
  "name": "cardano402",
  "version": "2.0.0",
  "private": true,
  "description": "cardano402.com: a Cardano x402 facilitator on Cloudflare Workers, built on the x402 Foundation @x402/cardano reference implementation. Keyless: it only broadcasts payer-signed transactions.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MorganOnCode/cardano402.git"
  },
  "bugs": {
    "url": "https://github.com/MorganOnCode/cardano402/issues"
  },
  "homepage": "https://github.com/MorganOnCode/cardano402#readme",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cardano402/facilitator dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "unrs-resolver"
    ],
    "overrides": {
      "libsodium-wrappers-sumo": "0.8.2",
      "libsodium-sumo": "0.8.2",
      "fast-uri": "^3.1.5",
      "yaml": "^2.9.0",
      "vite": "^7.3.6",
      "flatted": "^3.4.2",
      "ajv@>=7": "^8.20.0",
      "minimatch@<10": "^3.1.4",
      "minimatch@>=10": "^10.2.5",
      "brace-expansion@<2": "^1.1.18",
      "brace-expansion@>=2": "^2.1.4",
      "@babel/core": "^7.29.6",
      "body-parser": "^2.3.0",
      "esbuild": "^0.28.1",
      "find-my-way": "^9.7.0",
      "form-data": "^4.0.6",
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "ip-address": "^10.3.1",
      "js-yaml@>=4": "^4.3.1",
      "nanoid@<4": "^3.3.18",
      "@opentelemetry/core": "^2.8.0",
      "postcss": "^8.5.23",
      "sharp": "^0.35.4"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "apps/**/*.ts": [
      "prettier --write"
    ]
  }
}
