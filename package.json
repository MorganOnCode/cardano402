{
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@rolldown/binding-darwin-arm64",
      "unrs-resolver"
    ],
    "overrides": {
      "libsodium-wrappers-sumo": "0.8.2",
      "libsodium-sumo": "0.8.2",
      "fast-uri": "^3.1.5",
      "yaml": "^2.9.0",
      "vite": "^7.3.6",
      "flatted": "^3.4.2",
      "ajv@>=7": "^8.20.0",
      "minimatch@<10": "^3.1.4",
      "minimatch@>=10": "^10.2.5",
      "brace-expansion@<2": "^1.1.18",
      "brace-expansion@>=2": "^2.1.4",
      "@babel/core": "^7.29.6",
      "body-parser": "^2.3.0",
      "esbuild": "^0.28.1",
      "find-my-way": "^9.7.0",
      "form-data": "^4.0.6",
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "ip-address": "^10.3.1",
      "js-yaml@>=4": "^4.3.1",
      "nanoid@<4": "^3.3.18",
      "@opentelemetry/core": "^2.8.0",
      "postcss": "^8.5.23"
    }
  },
  "name": "cardano402",
  "version": "1.1.0",
  "description": "Open-source x402 payment facilitator and resource server SDK for Cardano. Agent-native, registry-free.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sdk": {
      "import": "./dist/sdk.js",
      "types": "./dist/sdk.d.ts"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --inspect src/index.ts",
    "build": "tsup && pnpm build:landing",
    "build:landing": "node scripts/build-landing.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prepare": "husky && pnpm --filter @cardano402/core build",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "x402",
    "cardano",
    "payment",
    "facilitator",
    "agent",
    "mcp",
    "stripe-for-agents"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MorganOnCode/cardano402.git"
  },
  "bugs": {
    "url": "https://github.com/MorganOnCode/cardano402/issues"
  },
  "homepage": "https://github.com/MorganOnCode/cardano402#readme",
  "packageManager": "pnpm@10.8.1",
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@blockfrost/blockfrost-js": "^6.1.1",
    "@cardano402/core": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/error": "^4.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@lucid-evolution/lucid": "0.5.1",
    "@lucid-evolution/provider": "0.1.95",
    "@sentry/node": "^10.55.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.11.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-airbnb-extended": "^3.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.10",
    "vite": "^7.3.6"
  }
}
