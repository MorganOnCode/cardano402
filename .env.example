# cardano402 — production environment variables
# Copy to .env and fill in values before running docker-compose.prod.yml

# Redis password (choose a strong random string)
REDIS_PASSWORD=changeme-use-a-strong-password

# Mainnet safety guardrail. Must be "true" if config.json has
# chain.network = "Mainnet"; the facilitator refuses to boot otherwise.
# Default ("false" or omitted) prevents accidental mainnet boots.
# See docs/operations.md.
MAINNET=false
