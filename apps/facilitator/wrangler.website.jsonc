{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Static cardano402.com website. Assets only: there is deliberately no
  // "main" script, binding, secret or service, so no request can reach a
  // facilitator, the demo or the VPS origin. Build with `pnpm build:website`.
  "name": "cardano402-website",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // Unmatched paths, including the retired API and discovery paths, get
  // website-dist/404.html with status 404, never the landing page (no SPA).
  "assets": { "directory": "./website-dist", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  // Routes on the existing proxied DNS records. With no script, the Worker
  // answers every request itself; DNS and tunnel ingress are unchanged, so
  // deleting these two routes is the complete rollback.
  "routes": [
    { "pattern": "cardano402.com/*", "zone_name": "cardano402.com" },
    { "pattern": "www.cardano402.com/*", "zone_name": "cardano402.com" }
  ],
  "env": {
    // Staged review copy on workers.dev, deployed only by a manual workflow run.
    "staging": {
      "name": "cardano402-website-staging",
      "workers_dev": true,
      "routes": []
    }
  }
}
