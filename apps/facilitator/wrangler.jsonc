{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cardano402",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": false },

  // Top-level config is a local-dev default only. Deploys always name an env.
  "workers_dev": false,
  "services": [{ "binding": "DEMO", "service": "cardano402-demo-preview" }],
  "vars": { "CARDANO_NETWORK": "cardano:preview", "LIVE_DEMO_ENABLED": "false" },
  "durable_objects": {
    "bindings": [{ "name": "SETTLEMENTS", "class_name": "SettlementStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SettlementStore"] }],
  "ratelimits": [
    { "name": "PAYMENT_LIMITER", "namespace_id": "4021", "simple": { "limit": 12, "period": 60 } }
  ],

  // Secrets (wrangler secret put <NAME> --env <env>), never in this file:
  //   BLOCKFROST_PROJECT_ID  Blockfrost project id for the env's network.
  // There is deliberately no wallet key. The facilitator only broadcasts
  // payer-signed transactions, so it holds no keys and no funds.
  "env": {
    "preview": {
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "name": "cardano402-preview",
      "services": [{ "binding": "DEMO", "service": "cardano402-demo-preview" }],
      "workers_dev": true,
      "vars": { "CARDANO_NETWORK": "cardano:preview", "LIVE_DEMO_ENABLED": "true" },
      "durable_objects": {
        "bindings": [{ "name": "SETTLEMENTS", "class_name": "SettlementStore" }]
      },
      "ratelimits": [
        { "name": "PAYMENT_LIMITER", "namespace_id": "4022", "simple": { "limit": 12, "period": 60 } }
      ]
    },
    "production": {
      "name": "cardano402",
      "services": [{ "binding": "DEMO", "service": "cardano402-demo" }],
      "workers_dev": false,
      "vars": { "CARDANO_NETWORK": "cardano:preview", "LIVE_DEMO_ENABLED": "false" },
      "durable_objects": {
        "bindings": [{ "name": "SETTLEMENTS", "class_name": "SettlementStore" }]
      },
      "ratelimits": [
        { "name": "PAYMENT_LIMITER", "namespace_id": "4023", "simple": { "limit": 12, "period": 60 } }
      ]
      // Routes are added at cutover, not before (the VPS still serves the domain):
      // "routes": [
      //   { "pattern": "cardano402.com", "custom_domain": true },
      //   { "pattern": "www.cardano402.com", "custom_domain": true }
      // ]
    }
  }
}
