{
  "name": "@cardano402/core",
  "version": "0.2.0",
  "description": "Schemas, types, header codec, and FacilitatorClient for x402 payments on Cardano. Zero-runtime-dep core (except zod) for clients, resource servers, and MCP tooling.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SPEC_TRUTH.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/MorganOnCode/cardano402/tree/master/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MorganOnCode/cardano402.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/MorganOnCode/cardano402/issues"
  },
  "keywords": [
    "x402",
    "cardano",
    "payment",
    "facilitator",
    "agent",
    "mcp",
    "ada",
    "stripe-for-agents",
    "zod"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "fast-check": "^4.8.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
