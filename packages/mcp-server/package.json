{
  "name": "@cardano402/mcp-server",
  "version": "0.1.2",
  "description": "MCP server that exposes paid HTTP endpoints as MCP tools, paying via the x402 Cardano scheme.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cardano402-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MorganOnCode/cardano402.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/MorganOnCode/cardano402/issues"
  },
  "keywords": [
    "x402",
    "cardano",
    "mcp",
    "model-context-protocol",
    "agent",
    "payment",
    "stripe-for-agents"
  ],
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "verify:version": "node scripts/gen-version.mjs && git diff --exit-code src/generated-version.ts",
    "build": "pnpm gen:version && tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "dependencies": {
    "@cardano402/core": "workspace:^",
    "@lucid-evolution/lucid": "0.4.29",
    "@lucid-evolution/provider": "0.1.90",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "libsodium-wrappers-sumo": "0.8.2",
    "libsodium-sumo": "0.8.2"
  }
}
