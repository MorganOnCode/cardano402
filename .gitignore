# Dependencies
node_modules/

# Build output
dist/

# Environment and config (secrets)
# Treat every JSON in config/ as sensitive by default. Only the explicit
# example template is committed.
config/*.json
!config/config.example.json
!config/config.development.example.json
config.json
config/cmds.bash
secrets/
.env
.env.*
!.env.example

# Coverage
coverage/

# IDE
.idea/
.obsidian/
*.swp
*.swo

# Claude Code (local-only settings, agent memory, scratch)
.claude/

# macOS
.DS_Store

# Windows
Thumbs.db

# Logs
*.log
logs/

# Test artifacts
.vitest/
tests/fixtures/

# Runtime data
data/
.bg-shell/
.env.client
config/config.mainnet.json

# Workspace scratch (not for commit)
.auditing/
.planning/

# pnpm install temporary files (orphans from failed installs)
_tmp_*

# Vendored x402-rs reference impl is NOT a submodule and should be moved
# out-of-tree before the next public push. Until then, keep it ignored
# from clean checkouts.
x402-rs-main/
